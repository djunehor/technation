# Server Configuration
PORT=3000
DEBUG=false

# LLM Configuration
# Options: gemini, openai, anthropic
LLM_PROVIDER=gemini
# Optional: Specific model to use. Defaults:
# gemini -> gemini-2.5-pro
# openai -> gpt-4o
# anthropic -> claude-3-opus-20240229
LLM_MODEL=

# Gemini / Vertex AI
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
